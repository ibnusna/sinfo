<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve existing files/directories in root
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Serve files from the public folder if they exist there
    RewriteCond %{DOCUMENT_ROOT}/sinfo/public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    # Rewrite all other URLs to index.php
    RewriteRule ^ index.php [L]
</IfModule>
